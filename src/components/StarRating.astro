---
import { clampRating } from '../lib/ratings';
import Stars from './Stars.astro';

interface Props {
    rating: number | null;
}

const { rating } = Astro.props;
---

{rating !== null && (
    <div class="flex items-center">
        <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
            <Stars rating={rating} class="mr-1" />
            {clampRating(rating).toFixed(1)}
        </span>
    </div>
)}
