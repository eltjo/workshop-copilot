---
import type { Category, Publisher } from '../types/game';

interface Props {
    categories: Category[];
    publishers: Publisher[];
    total: number;
}

const { categories, publishers, total } = Astro.props;
---

<form
    class="mb-8 bg-slate-800/60 rounded-xl border border-slate-700/50 p-6 space-y-5"
    data-testid="game-filters"
    aria-label="Filter games"
>
    <fieldset class="space-y-3">
        <legend class="text-sm font-medium text-slate-300 mb-2">Categories</legend>
        <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
                <label
                    class="inline-flex items-center gap-2 rounded-lg bg-slate-700/50 px-3 py-2 text-sm text-slate-100 cursor-pointer hover:bg-slate-700 has-focus-visible:ring-2 has-focus-visible:ring-blue-500"
                >
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-500 bg-slate-800 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        data-testid={`filter-category-${category.id}`}
                    />
                    {category.name}
                </label>
            ))}
        </div>
    </fieldset>

    <div class="flex flex-wrap items-end gap-4">
        <div class="flex flex-col gap-2">
            <label for="filter-publisher" class="text-sm font-medium text-slate-300">Publisher</label>
            <select
                id="filter-publisher"
                name="publisher"
                class="rounded-lg bg-slate-700 border border-slate-600 px-3 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="filter-publisher"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
        </div>

        <button
            type="reset"
            class="rounded-lg bg-slate-700 px-4 py-2 text-sm font-medium text-slate-100 hover:bg-slate-600 transition-colors focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="filter-clear"
        >
            Clear filters
        </button>
    </div>

    <p class="text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-status" data-total={total}>
        Showing {total} of {total} games
    </p>
</form>

<script>
    const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const status = document.querySelector<HTMLElement>('[data-testid="filter-status"]');
    const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
    const total = cards.length;

    function applyFilters(): void {
        if (!form || !status) return;
        const categoryIds = new Set(
            Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]:checked')).map((i) => i.value),
        );
        const publisherId = form.querySelector<HTMLSelectElement>('select[name="publisher"]')?.value ?? '';

        let visible = 0;
        for (const card of cards) {
            const matchesCategory = categoryIds.size === 0 || categoryIds.has(card.dataset.categoryId ?? '');
            const matchesPublisher = publisherId === '' || card.dataset.publisherId === publisherId;
            const show = matchesCategory && matchesPublisher;
            card.hidden = !show;
            if (show) visible++;
        }

        status.textContent = `Showing ${visible} of ${total} games`;
        if (emptyState) emptyState.hidden = visible !== 0;
    }

    form?.addEventListener('change', applyFilters);
    // Reset restores defaults after the event, so re-apply on the next tick.
    form?.addEventListener('reset', () => setTimeout(applyFilters, 0));
</script>
